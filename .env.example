# --------------------------------------------------------------------- Flask
SECRET_KEY=change-me-in-production
FLASK_DEBUG=false
FLASK_PORT=5000

# --------------------------------------------------------------------- Redis
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300
CACHE_ENABLED=true

# -------------------------------------------------------------------- Mongo
MONGO_URI=mongodb://mongo:27017
MONGO_DB=scrapling_api
PERSIST_ENABLED=true

# ------------------------------------------------------------------ Limits
MAX_COMMANDS=20
MAX_OUTPUT_LENGTH=500000
DEFAULT_TIMEOUT_SECONDS=30
DEFAULT_BROWSER_TIMEOUT_MS=30000

# --------------------------------------------------------------- Host controls
# Leave ALLOWED_HOSTS empty to allow all hosts (no whitelist).
# Comma-separated values, e.g.: example.com,trusted.org
ALLOWED_HOSTS=
# Hosts that are always blocked; comma-separated.
BLOCKED_HOSTS=
